# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Upstash Redis — added automatically when you link a Redis integration in the Vercel dashboard.
# For local dev, copy these from: Vercel Dashboard → Integrations → Upstash → your database → ".env.local" tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Giphy API key — free at https://developers.giphy.com (Create App → SDK)
NEXT_PUBLIC_GIPHY_KEY=
# Optional alternative provider (ad-free GIF integration)
NEXT_PUBLIC_KLIPY_KEY=
# Primary provider: giphy or klipy. Defaults to the first configured provider.
NEXT_PUBLIC_GIF_PROVIDER=giphy
# Automatically switch providers when the current search quota is exhausted.
NEXT_PUBLIC_GIF_AUTO_FALLBACK=true
# Site-wide rolling hourly API budgets, including KLIPY share reporting.
GIPHY_SEARCH_HOURLY_BUDGET=85
KLIPY_SEARCH_HOURLY_BUDGET=85

# Public site URL used for canonical/SEO metadata (production domain)
NEXT_PUBLIC_SITE_URL=https://gifbattles.com

# Sentry DSN for frontend + server error tracking
NEXT_PUBLIC_SENTRY_DSN=
# Optional server-only DSN override (if set, server/edge uses this instead of NEXT_PUBLIC_SENTRY_DSN)
SENTRY_DSN=
# Optional tracing sample rate in [0,1], default is 0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional: only needed if you want source map upload during build
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Blob Storage - for local dev, create a read/write token in the Vercel dashboard: Settings → Blob Storage → Tokens → Create Token (read/write)
BLOB_READ_WRITE_TOKEN=

# Offline stock search only; never prefix this with NEXT_PUBLIC_.
# Obtain a key at https://www.pexels.com/api/ (Commons search needs no key).
PEXELS_API_KEY=

# Required for the scheduled deletion of expired temporary memes.
# Set a random secret in Vercel; the daily job sends it in Authorization.
CRON_SECRET=

# Caption suggestions use the host's room key. Offline tagging/generation uses this separate server-only key.
GEMINI_MEDIA_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.5-flash-lite
GEMINI_STOCK_IMAGE_MODEL=gemini-3.1-flash-image
# Protects the contribution moderation API; use a random value of at least 24 characters.
MEDIA_ADMIN_SECRET=

# Optional: separate PRIVATE store for review archive backups. Never reuse the public stock token.
MEDIA_ARCHIVE_BLOB_READ_WRITE_TOKEN=
# Optional Openverse source filter; defaults to sources with direct verification support.
OPENVERSE_SOURCES=wikimedia,met
# Offline source pacing, including origin metadata and image downloads.
# Provider Retry-After cooldowns take precedence. Run one importer at a time.
COMMONS_REQUEST_INTERVAL_MS=5000
OPENVERSE_REQUEST_INTERVAL_MS=45000

# Offline bulk sourcing: default 19 seconds between Pexels API searches.
PEXELS_REQUEST_INTERVAL_MS=19000

# Production/preview: live approved catalog in Blob, pointer in existing Redis.
# Local default is the tiny checked-in fixture; set blob to browse real stock.
MEDIA_CATALOG_SOURCE=fixture
